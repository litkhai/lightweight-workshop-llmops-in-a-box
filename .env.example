# Reference configuration for a local-only workshop.
# Prefer ./setup.sh: it generates unique secrets and writes .env with mode 0600.

COMPOSE_PROFILES='local-clickhouse,local-model'

WORKSHOP_USER_ID='admin'
WORKSHOP_USER_EMAIL='admin@example.com'
WORKSHOP_PASSWORD='Clickhouse_4U'

MODEL_MODE='local'
DOCKER_MEMORY_GB='8'
ANTHROPIC_API_KEY=''
OLLAMA_MODEL='qwen3:1.7b'

LITELLM_MASTER_KEY='sk-workshop-key'
LITELLM_PORT='4000'
LIBRECHAT_PORT='3080'
LANGFUSE_PORT='3000'
MINIO_PORT='9090'

LANGFUSE_PUBLIC_KEY='pk-lf-workshop'
LANGFUSE_SECRET_KEY='sk-lf-workshop'
LANGFUSE_SALT='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
LANGFUSE_ENCRYPTION_KEY='abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789'
LANGFUSE_NEXTAUTH_SECRET='workshop-nextauth-secret'

POSTGRES_USER='langfuse'
POSTGRES_PASSWORD='workshop-postgres-password'
POSTGRES_DB='langfuse'
REDIS_AUTH='workshop-redis-password'
MINIO_ROOT_USER='minio'
MINIO_ROOT_PASSWORD='workshop-minio-password'

CLICKHOUSE_MODE='local'
CLICKHOUSE_URL='http://clickhouse:8123'
CLICKHOUSE_MIGRATION_URL='clickhouse://clickhouse:9000'
CLICKHOUSE_MIGRATION_SSL='false'
CLICKHOUSE_USER='langfuse'
CLICKHOUSE_PASSWORD='workshop-clickhouse-password'
CLICKHOUSE_DB='langfuse'
CLICKHOUSE_CLUSTER_ENABLED='false'

LIBRECHAT_JWT_SECRET='workshop-jwt-secret'
LIBRECHAT_JWT_REFRESH_SECRET='workshop-jwt-refresh-secret'
LIBRECHAT_CREDS_KEY='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
LIBRECHAT_CREDS_IV='0123456789abcdef0123456789abcdef'
