# ── LiteLLM gateway ──────────────────────────────────────────────────────────
# Any string works as a local API key.
LITELLM_MASTER_KEY=sk-workshop-key

# ── Langfuse observability ────────────────────────────────────────────────────
# These match the LANGFUSE_INIT_* values in docker-compose.yml.
# Langfuse creates this project and API key pair automatically on first boot.
# Change only if you modified the INIT values.
LANGFUSE_PUBLIC_KEY=pk-lf-workshop
LANGFUSE_SECRET_KEY=sk-lf-workshop

# ── Optional: cloud model for Korean (Hangul) messages ───────────────────────
# Leave unset to route everything to the local Ollama model.
# When set, Korean-heavy messages are routed to claude-sonnet instead of local.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Port overrides (optional) ─────────────────────────────────────────────────
# LITELLM_PORT=4000
# LANGFUSE_PORT=3000
